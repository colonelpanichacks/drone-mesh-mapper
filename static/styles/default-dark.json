{
  "version": 8,
  "name": "mesh-mapper-dark",
  "metadata": {"description": "No-glyph dark style for OpenMapTiles vector schema. Matches mesh-mapper aesthetic. Drop in glyphs to enable text labels."},
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "__SOURCE_URL__"
    }
  },
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#000000"}},
    {"id": "landcover-glacier", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "subclass", "glacier"],
      "paint": {"fill-color": "#0a1a2a", "fill-opacity": 0.5}},
    {"id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "wood", "forest"],
      "paint": {"fill-color": "#06180a", "fill-opacity": 0.6}},
    {"id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "grass", "park", "meadow"],
      "paint": {"fill-color": "#0a1f0a", "fill-opacity": 0.5}},
    {"id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {"fill-color": "#0a0a0a", "fill-opacity": 0.6}},
    {"id": "landuse-industrial", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", "class", "industrial", "commercial"],
      "paint": {"fill-color": "#0c0c14", "fill-opacity": 0.6}},
    {"id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": {"fill-color": "#082010", "fill-opacity": 0.6}},
    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["!=", "intermittent", 1],
      "paint": {"fill-color": "#001530"}},
    {"id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": {"line-color": "#00aaff", "line-opacity": 0.4, "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 18, 2]}},
    {"id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {"line-color": "#ff00ff", "line-opacity": 0.6, "line-width": 1.2, "line-dasharray": [3, 2]}},
    {"id": "boundary-state", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {"line-color": "#aa00aa", "line-opacity": 0.5, "line-width": 0.8, "line-dasharray": [2, 2]}},
    {"id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": {"line-color": "#003322", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.3, 18, 2]}},
    {"id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {"line-color": "#005544", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 18, 4]}},
    {"id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {"line-color": "#00aa66", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 18, 6]}},
    {"id": "road-trunk", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "paint": {"line-color": "#00ff88", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 18, 7]}},
    {"id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {"line-color": "#00ffaa", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 18, 8]}},
    {"id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": {"line-color": "#666688", "line-width": 0.8, "line-dasharray": [4, 2]}},
    {"id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building",
      "minzoom": 13,
      "paint": {"fill-color": "#0c1a0c", "fill-outline-color": "#003300", "fill-opacity": 0.7}}
  ]
}
